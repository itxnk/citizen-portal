# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars with sensitive values to source control

aws_region   = "ap-south-1"
environment  = "demo"
project_name = "desc-cloudnative"

# VPC
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]

# EKS
eks_cluster_version    = "1.29"
eks_node_instance_type = "t3.medium"
eks_node_min_size      = 2
eks_node_max_size      = 10
eks_node_desired_size  = 3

# RDS
rds_instance_class        = "db.t3.medium"
rds_engine_version        = "15.5"
rds_allocated_storage     = 20
rds_max_allocated_storage = 100
rds_db_name               = "descapp"
rds_username              = "descadmin"  # password generated by Terraform, stored in Secrets Manager
rds_backup_retention_days = 7
rds_multi_az              = true

# ElastiCache
elasticache_node_type      = "cache.t3.micro"
elasticache_num_replicas   = 1
elasticache_engine_version = "7.1"

# ArgoCD
argocd_hostname = "argocd.desc-demo.com"
git_repo_url    = "https://github.com/your-org/desc-cloudnative-demo"
